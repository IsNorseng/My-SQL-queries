-- Анализ пересечения зон покрытия курьерских служб.
-- Территория: регион + почтовый индекс.
-- Индекс Жаккара = пересечение / объединение.
-- Каждая пара служб учитывается один раз.

WITH coverage AS (
    -- Уникальные территории обслуживания.
    SELECT DISTINCT
        region,
        postal_code,
        carrier
    FROM analytics.courier_coverage
    WHERE region IS NOT NULL
      AND postal_code IS NOT NULL
      AND carrier IS NOT NULL
),

carrier_coverage AS (
    -- Количество территорий каждой службы.
    SELECT
        carrier,
        COUNT(*) AS total_areas
    FROM coverage
    GROUP BY carrier
),

carrier_pairs AS (
    -- Формирование всех уникальных пар операторов.
    SELECT
        a.carrier AS carrier_a,
        b.carrier AS carrier_b,
        a.total_areas AS areas_a,
        b.total_areas AS areas_b
    FROM carrier_coverage AS a
    INNER JOIN carrier_coverage AS b
        ON a.carrier < b.carrier
),

intersections AS (
    -- Территории, обслуживаемые обеими службами.
    SELECT
        a.carrier AS carrier_a,
        b.carrier AS carrier_b,
        COUNT(*) AS shared_areas
    FROM coverage AS a
    INNER JOIN coverage AS b
        ON a.region = b.region
       AND a.postal_code = b.postal_code
       AND a.carrier < b.carrier
    GROUP BY
        a.carrier,
        b.carrier
)

SELECT
    p.carrier_a,
    p.carrier_b,
    p.areas_a,
    p.areas_b,

    COALESCE(i.shared_areas, 0) AS shared_areas,

    -- Объединённое покрытие двух операторов.
    p.areas_a + p.areas_b
        - COALESCE(i.shared_areas, 0) AS union_areas,

    -- Индекс Жаккара (от 0 до 1).
    ROUND(
        COALESCE(i.shared_areas, 0)::numeric
        / NULLIF(
            p.areas_a + p.areas_b
            - COALESCE(i.shared_areas, 0), 0
        ),
        4
    ) AS jaccard_index,

    -- Дополнительное покрытие второй службы.
    p.areas_b - COALESCE(i.shared_areas, 0)
        AS additional_areas_b

FROM carrier_pairs AS p
LEFT JOIN intersections AS i
    ON p.carrier_a = i.carrier_a
   AND p.carrier_b = i.carrier_b

ORDER BY union_areas DESC;
