
-- Анализ качества лидов по регионам (RU, NY).
-- Период: 20–23 февраля 2026 года.
-- Метрики: валидность, одобрение, отказы, обратные звонки,
-- установленные соединения и операционный аппрув.
-- Все доли округляются до 4 знаков.

WITH lead_metrics AS (
    SELECT
        t1.Region AS region,
        COUNT(t1.id) AS total_leads,

        -- Валидные и одобренные лиды.
        COUNT(CASE
            WHEN t4.StatusName NOT IN ('Declined', 'Test')
            THEN t1.id
        END) AS valid_leads,

        COUNT(CASE
            WHEN t1.Flag1 = 1 THEN t1.id
        END) AS approved_leads,

        -- Отказы и причины отклонения.
        COUNT(CASE
            WHEN t4.StatusName = 'Rejection' THEN t1.id
        END) AS rejected_leads,

        COUNT(CASE
            WHEN t4.StatusName = 'Declined' THEN t1.id
        END) AS declined_leads,

        COUNT(CASE
            WHEN t3.StatusName = 'Non Existing Number' THEN t1.id
        END) AS invalid_numbers,

        -- Обратные звонки и соединения.
        COUNT(CASE
            WHEN t4.StatusName = 'Callback' THEN t1.id
        END) AS callback_leads,

        COUNT(CASE
            WHEN t4.StatusName = 'CallbackOut' THEN t1.id
        END) AS callback_out_leads,

        COUNT(CASE
            WHEN t1.IsConnectedFlag = 1 THEN t1.id
        END) AS connected_leads

    FROM Table1 AS t1

    LEFT JOIN Table3 AS t3
        ON t1.SubStatusId = t3.id

    LEFT JOIN Table4 AS t4
        ON t1.StatusId = t4.id

    WHERE t1.Region IN ('RU', 'NY')
      AND t1.OrderDate >= '20260220'
      AND t1.OrderDate < '20260224'

    GROUP BY t1.Region
)

SELECT
    region,
    total_leads,

    -- Качество лидов.
    ROUND(valid_leads * 1.0 / NULLIF(total_leads, 0), 4)
        AS percent_valid_leads,

    ROUND(approved_leads * 1.0 / NULLIF(total_leads, 0), 4)
        AS dirt_approve,

    ROUND(approved_leads * 1.0 / NULLIF(valid_leads, 0), 4)
        AS clean_approve,

    -- Статистика отказов.
    ROUND(rejected_leads * 1.0 / NULLIF(total_leads, 0), 4)
        AS percent_rejection,

    ROUND(declined_leads * 1.0 / NULLIF(total_leads, 0), 4)
        AS percent_declined,

    ROUND(invalid_numbers * 1.0 / NULLIF(total_leads, 0), 4)
        AS percent_non_existing_number,

    -- Обратные звонки и соединения.
    ROUND(callback_leads * 1.0 / NULLIF(total_leads, 0), 4)
        AS percent_callback,

    ROUND(callback_out_leads * 1.0 / NULLIF(total_leads, 0), 4)
        AS percent_callback_out,

    ROUND(connected_leads * 1.0 / NULLIF(total_leads, 0), 4)
        AS percent_isConnected,

    -- Операционный аппрув.
    ROUND(
        approved_leads * 1.0
        / NULLIF(approved_leads + rejected_leads, 0),
        4
    ) AS work_approve

FROM lead_metrics
ORDER BY region;

