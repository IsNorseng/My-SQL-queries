
-- Накопленный LTV по месяцу регистрации пользователя.
-- LTV = выручка когорты / число зарегистрированных пользователей.

WITH user_revenue AS (
    SELECT
        user_id,
        SUM(total_amt) AS revenue
    FROM tools_shop.orders
    GROUP BY user_id
)

SELECT
    DATE_TRUNC('month', u.created_at)::date AS registration_month,
    COUNT(*) AS total_users,
    COUNT(r.user_id) AS paying_users,
    ROUND(
        SUM(COALESCE(r.revenue, 0))::numeric
        / NULLIF(COUNT(*), 0),
        2
    ) AS ltv
FROM tools_shop.users AS u
LEFT JOIN user_revenue AS r
    ON u.user_id = r.user_id
GROUP BY DATE_TRUNC('month', u.created_at)::date
ORDER BY registration_month;


-- Конверсия зарегистрированных пользователей в покупатели.
-- Conversion Rate = покупатели / пользователи * 100%.

SELECT
    COUNT(DISTINCT u.user_id) AS total_users,
    COUNT(DISTINCT o.user_id) AS paying_users,
    ROUND(
        COUNT(DISTINCT o.user_id) * 100.0
        / NULLIF(COUNT(DISTINCT u.user_id), 0),
        2
    ) AS conversion_rate_pct
FROM tools_shop.users AS u
LEFT JOIN tools_shop.orders AS o
    ON u.user_id = o.user_id;


-- Среднегодовой ARPPU.
-- ARPPU = выручка за год / уникальные покупатели за год.

SELECT
    DATE_TRUNC('year', o.created_at)::date AS order_year,
    COUNT(DISTINCT o.user_id) AS paying_users,
    SUM(o.total_amt) AS total_revenue,
    ROUND(
        SUM(o.total_amt)::numeric
        / NULLIF(COUNT(DISTINCT o.user_id), 0),
        2
    ) AS arppu
FROM tools_shop.orders AS o
INNER JOIN tools_shop.users AS u
    ON o.user_id = u.user_id
GROUP BY DATE_TRUNC('year', o.created_at)::date
ORDER BY order_year;


-- Помесячная рентабельность затрат.
-- ROI = (выручка - затраты) / затраты * 100%.

WITH monthly_costs AS (
    SELECT
        DATE_TRUNC('month', created_at)::date AS month,
        SUM(costs) AS total_costs
    FROM tools_shop.costs
    GROUP BY DATE_TRUNC('month', created_at)::date
),

monthly_revenue AS (
    SELECT
        DATE_TRUNC('month', paid_at)::date AS month,
        SUM(total_amt) AS total_revenue
    FROM tools_shop.orders
    WHERE paid_at IS NOT NULL
    GROUP BY DATE_TRUNC('month', paid_at)::date
)

SELECT
    COALESCE(c.month, r.month) AS month,
    COALESCE(r.total_revenue, 0) AS total_revenue,
    COALESCE(c.total_costs, 0) AS total_costs,
    ROUND(
        (
            COALESCE(r.total_revenue, 0)
            - COALESCE(c.total_costs, 0)
        )::numeric * 100.0
        / NULLIF(c.total_costs, 0),
        2
    ) AS roi_pct
FROM monthly_costs AS c
FULL OUTER JOIN monthly_revenue AS r
    ON c.month = r.month
ORDER BY month;


Отчёт по продажам дополнительных товаров
-- Анализ продаж дополнительных товаров.
-- Период: январь 2023 года.

SET TRANSACTION ISOLATION LEVEL READ UNCOMMITTED

SELECT 
    t1.client_country,
    t1.main_product,
    t1.additional_product,
    AVG(t1.cost_percentage) AS avg_cost_percentage,
    AVG(t1.additional_price) AS avg_additional_price,
    AVG(t1.avg_additional_product_value) AS avg_additional_product_value,
    t2.total_approved_orders,
    COUNT(DISTINCT t1.order_id) AS orders_with_additional_product,
    SUM(t1.additional_quantity) AS total_additional_quantity
FROM
    (SELECT
        o.id AS order_id,
        o.country as client_country,
        os.name AS order_status,
        p1.name AS main_product,
        o.total_amount AS order_total_value,
        p2.name AS additional_product,
        op.quantity AS additional_quantity,
        op.additional_price,
        ap.cost_percentage,
        (o.total_amount - ((ap.cost_percentage * op.quantity) + (op.additional_price * op.quantity))) AS order_value_without_additional,
        CAST(((ap.cost_percentage + op.additional_price) * op.quantity) AS float) / CAST(op.quantity AS float) AS avg_additional_product_value
    FROM Orders o
    LEFT JOIN OrderStatus os ON o.status_id = os.id
    LEFT JOIN Products p1 ON o.product_id = p1.id
    LEFT JOIN OrderAdditionalProducts op ON op.order_id = o.id 
    LEFT JOIN AdditionalProducts ap ON op.additional_product_id = ap.id 
    LEFT JOIN Products p2 ON ap.product_item_id = p2.id 
    WHERE o.order_date BETWEEN '2023-01-01' AND '2023-02-01'
        AND p2.name IS NOT NULL
        AND o.is_approved = 1
        AND o.order_type = 0
        AND op.is_active = 1
    ) AS t1
LEFT JOIN 
    (SELECT 
        p3.name AS product_name,
        COUNT(o.id) AS total_approved_orders
    FROM Orders o
    LEFT JOIN OrderStatus os ON o.status_id = os.id
    LEFT JOIN Products p3 ON o.product_id = p3.id
    WHERE o.order_date BETWEEN '2023-01-01' AND '2023-02-01'
        AND o.is_approved = 1
        AND o.order_type = 0
    GROUP BY p3.name
    ) AS t2
    ON t1.main_product = t2.product_name
GROUP BY 
    t1.client_country, 
    t1.main_product, 
    t1.additional_product, 
    t2.total_approved_orders


Статистика лидов по продуктам и странам

-- Dirty Approval = одобренные / все записи.
-- Operational Approval = одобренные / (одобренные + отказы).

DECLARE
    @D_START DATE = '2023-10-28',
    @D_END DATE = '2023-11-10';

WITH approval_metrics AS (
    SELECT
        p.Name AS product_name,
        r.Area AS region,

        COUNT(*) AS total_records,

        SUM(
            CASE WHEN r.Approval = 1 THEN 1 ELSE 0 END
        ) AS approved_entries,

        SUM(
            CASE WHEN r.RecordStatus = 4 THEN 1 ELSE 0 END
        ) AS rejected_entries,

        AVG(
            CASE
                WHEN r.Approval = 1
                THEN CAST(r.TotalAmountWithoutDeadstock AS DECIMAL(18, 2))
            END
        ) AS average_approved_value

    FROM Record AS r

    LEFT JOIN Product AS p
        ON r.Product = p.id

    WHERE r.DateOfRecord >= @D_START
      AND r.DateOfRecord < DATEADD(DAY, 1, @D_END)
      AND r.Type = 0

    GROUP BY
        p.id,
        p.Name,
        r.Area
)

SELECT
    product_name,
    region,
    total_records,
    approved_entries,
    rejected_entries,
    average_approved_value,

    ROUND(
        rejected_entries * 1.0
        / NULLIF(total_records, 0),
        4
    ) AS percent_denial,

    ROUND(
        approved_entries * 1.0
        / NULLIF(total_records, 0),
        4
    ) AS dirty_approval,

    ROUND(
        approved_entries * 1.0
        / NULLIF(approved_entries + rejected_entries, 0),
        4
    ) AS operational_approval

FROM approval_metrics

ORDER BY
    product_name,
    region;


-- Статистика лидов по продуктам и странам.
-- Период: 29 октября - 5 ноября 2022 года.

DECLARE
    @D_START DATE = '2022-10-29',
    @D_END DATE = '2022-11-05';

WITH lead_metrics AS (
    SELECT
        p.Name AS product,
        l.Country AS geo,

        COUNT(*) AS total_leads,

        SUM(
            CASE WHEN l.Approve = 1 THEN 1 ELSE 0 END
        ) AS approved_leads,

        SUM(
            CASE WHEN l.LeadStatus = 4 THEN 1 ELSE 0 END
        ) AS rejected_leads,

        AVG(
            CAST(l.TotalAmountWithoutDeadstock AS DECIMAL(18, 2))
        ) AS avg_lead_amount

    FROM Lead AS l

    LEFT JOIN Product AS p
        ON l.Product = p.Oid

    WHERE l.DateOfOrder >= @D_START
      AND l.DateOfOrder < DATEADD(DAY, 1, @D_END)
      AND l.LeadType = 0

    GROUP BY
        p.Oid,
        p.Name,
        l.Country
)

SELECT
    product,
    geo,
    total_leads,
    approved_leads,
    rejected_leads,
    avg_lead_amount,

    ROUND(
        rejected_leads * 1.0
        / NULLIF(total_leads, 0),
        4
    ) AS percent_rejection,

    ROUND(
        approved_leads * 1.0
        / NULLIF(total_leads, 0),
        4
    ) AS dirty_approval,

    ROUND(
        approved_leads * 1.0
        / NULLIF(approved_leads + rejected_leads, 0),
        4
    ) AS operational_approval

FROM lead_metrics

ORDER BY
    product,
    geo;


Поиск заказов, созданных на основе других заказов, с определением типа дочернего заказа.

-- Анализ связей между исходными и производными заказами.
-- Связь: Parent.UniqueId = Child.RelatedOrder.

DECLARE
    @D_START DATE = '2024-01-01',
    @D_END DATE = '2024-08-01';

WITH parent_orders AS (
    SELECT
        o.id,
        o.OrderDate,
        o.UniqueId
    FROM Orders AS o

    INNER JOIN OrderTypes AS ot
        ON o.OrderType = ot.id

    WHERE o.OrderDate >= @D_START
      AND o.OrderDate < DATEADD(DAY, 1, @D_END)
      AND ot.TypeName IN ('TypeA', 'TypeB')
),

child_orders AS (
    SELECT
        o.id,
        o.OrderDate,
        o.RelatedOrder,
        ot.TypeName AS order_type
    FROM Orders AS o

    LEFT JOIN OrderTypes AS ot
        ON o.OrderType = ot.id

    WHERE o.OrderDate >= @D_START
      AND o.OrderDate < DATEADD(DAY, 1, @D_END)
)

SELECT
    parent.id AS parent_order_id,
    child.id AS child_order_id,
    parent.OrderDate AS parent_order_date,
    child.OrderDate AS child_order_date,
    child.order_type AS child_order_type

FROM parent_orders AS parent

INNER JOIN child_orders AS child
    ON parent.UniqueId = child.RelatedOrder

ORDER BY
    parent.OrderDate,
    child.OrderDate;






